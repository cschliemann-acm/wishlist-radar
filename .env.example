# One setting per line: KEY=value. No quotes, no spaces. Comments go on their own lines.

# Password for the web interface
APP_PASSWORD=
# Long random string (openssl rand -hex 24) for the iPhone Shortcut
INGEST_TOKEN=

ANTHROPIC_API_KEY=

# eBay developer keys: https://developer.ebay.com/my/keys (Production keyset: App ID + Cert ID)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Speech-to-text for reels (pieces named in voiceovers): off | groq | openai
# groq has a free tier: https://console.groq.com/keys (same key as reel-tunes works)
TRANSCRIBE=groq
TRANSCRIBE_API_KEY=

# Optional: a mailbox for saved-search alert emails (Depop, Vinted, SSENSE…), see the Shops page.
# For Gmail: a dedicated account + an app password (Google Account → Security → App passwords)
# ALERTS_IMAP_USER=yourname.radar@gmail.com
# ALERTS_IMAP_PASSWORD=
# ALERTS_IMAP_HOST=imap.gmail.com

# Optional: Instagram cookies if downloads get blocked (see README)
# INSTAGRAM_COOKIES_B64=

# Optional: only if Grailed auto-discovery stops working (see README)
# GRAILED_ALGOLIA_APP_ID=
# GRAILED_ALGOLIA_API_KEY=
# GRAILED_ALGOLIA_INDEX=

# Optional overrides
# IDENTIFY_MODEL=claude-opus-5-5
# MATCH_MODEL=claude-haiku-5-5
# SECRET_KEY=
# DATA_DIR=./data
# SCHEDULER=on
